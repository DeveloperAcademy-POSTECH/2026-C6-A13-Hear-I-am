name: HearVoiceQA
options:
  deploymentTarget:
    iOS: '17.0'
packages:
  HearIAmCore:
    path: __REPO_ROOT__/Packages/HearIAmCore
settings:
  base:
    SWIFT_VERSION: '5.0'
    GENERATE_INFOPLIST_FILE: YES
    CODE_SIGNING_ALLOWED: NO
    TARGETED_DEVICE_FAMILY: '1'
targets:
  HearVoiceQA:
    type: application
    platform: iOS
    sources:
      - path: __REPO_ROOT__/Hear-I-am
        excludes: [App/Source/HearIAmApp.swift]
      - path: App
    dependencies:
      - package: HearIAmCore
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: org.heariam.voice86.qa
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
        INFOPLIST_KEY_NSMicrophoneUsageDescription: 음성 입력 검증
        INFOPLIST_KEY_NSSpeechRecognitionUsageDescription: 음성 입력 검증
        INFOPLIST_KEY_NSMotionUsageDescription: 정면 찾기 연습 검증
        INFOPLIST_KEY_NSCameraUsageDescription: 무대 스캔 검증
        INFOPLIST_KEY_UILaunchScreen_Generation: YES
        INFOPLIST_KEY_UIApplicationSceneManifest_Generation: YES
        INFOPLIST_KEY_UISupportedInterfaceOrientations: "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight"
  VoiceUITests:
    type: bundle.ui-testing
    platform: iOS
    sources: [UITests]
    dependencies:
      - target: HearVoiceQA
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: org.heariam.voice86.qa.uitests
  VoiceTests:
    type: bundle.unit-test
    platform: iOS
    sources: [Tests]
    dependencies:
      - target: HearVoiceQA
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: org.heariam.voice86.qa.playbacktests
schemes:
  HearVoiceQA:
    build:
      targets:
        HearVoiceQA: all
    test:
      targets: [VoiceUITests, VoiceTests]
